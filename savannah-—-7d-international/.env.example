# Required. Server-side only; never shipped to the browser.
GEMINI_API_KEY=

# Optional. Live model override (default gemini-3.1-flash-live-preview).
# LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Production: drop knowledge-base records that 7D has not approved.
# KB_APPROVED_ONLY=true

# Enquiries: destination inbox and a Resend API key. Unset = endpoint returns 503
# and the UI offers the official email/phone instead.
ENQUIRY_TO=
RESEND_API_KEY=
ENQUIRY_FROM=Savannah <savannah@7dint.net>

# Aggregate analytics at /api/admin/summary?key=...
ADMIN_KEY=

# Spend guard: sessions minted per day before "Savannah is resting".
DAILY_SESSION_CAP=500

# Stable secret for signing page nonces across restarts (random per boot if unset).
NONCE_SECRET=
